Stack-Version: 2026-10-31.1
Source-Owner: CTTIR
Source-Repository: inferguidR
Source-Path: .
Observed-Baseline-SHA: e91938f77eaa991b69989b121bfd32c124c95db0
Require-Current-Source-Discovery: true
Calc-Repository: infercalcR
Calc-Path: ../infercalcR
Report-Repository: infereportR
Report-Path: ../infereportR
New-Repository-Visibility: private
Create-Remote-Repositories: true
Push-New-Repositories: true
Push-Source-Feature-Branch: true
Open-Source-Pull-Request: true
Merge-Source-Pull-Request: false
Create-Release-Tags: false
Submit-To-CRAN: false
Change-Existing-Visibility: false
Force-Push: false
Branch-Prefix: refactor/infer-suite-split
Max-Workers: 3
Dependency-Policy: base-standard-r-first
New-Test-Framework: base-R
Core-Calc-Contributed-Dependency-Target: zero
Core-Report-Contributed-Dependency-Target: infercalcR-only
Required-Integration-Lanes: ggplot2,legacy-inferguidR,DescrTab2-import-render
Optional-Integration-Lanes: gtsummary,document-exporters,specialist-reference-comparators
Promote-Claimed-Backend-Lanes-To-Required: true
Keep-Legacy-Tests-Until-Equivalent-Coverage: true
Preserve-Legacy-JSON-And-Hashes: true
Evidence-Relative-Path: tools/infer-suite-migration
Mutable-Run-State-Relative-Path: tools/infer-suite-migration/runs
G11-Scope: required-local-candidate-checks
Remote-Actions-After-Local-Pass-With-Hosted-Pending: true
Require-Independent-Review: true
Allow-Scientific-Method-Substitution: false
Allow-Patient-Data-In-Fixtures: false

